# --- Option A: Google AI Studio API key (free, no billing / tax data required) ---
# Get one at https://aistudio.google.com/apikey
GOOGLE_GENAI_USE_VERTEXAI=False
# GEMINI_API_KEY is also accepted and takes precedence over GOOGLE_API_KEY.
# Values already set in your shell are NOT overwritten by this file.
GOOGLE_API_KEY=your-ai-studio-api-key

# --- Option B: Vertex AI (Google Cloud project with billing enabled) ---
# GOOGLE_GENAI_USE_VERTEXAI=True
# GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
# GOOGLE_CLOUD_LOCATION=global

# --- Optional tuning ---
# Backup model used automatically when the primary one returns 503 (empty disables it)
# BONDY_FALLBACK_MODEL=gemini-3.5-flash-lite
# Model used by the vision tools (alt text, decorative images, page screenshot)
# BONDY_VISION_MODEL=gemini-flash-latest
# Protects POST /api/apply-fix. If unset, only requests from localhost are accepted
# BONDY_API_KEY=change-me
