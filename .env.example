# --- API key for the semantic image stage (CLI and web UI) ---
# Get one at https://aistudio.google.com/apikey (free tier, no billing needed).
# Bondy reads ONLY GEMINI_API_KEY and GOOGLE_API_KEY from this file (CLI), and
# never from bondy.toml. GEMINI_API_KEY takes precedence over GOOGLE_API_KEY.
# Values already set in your shell are NOT overwritten by this file.
# Make sure `.env` is listed in your .gitignore. Without a key Bondy runs the
# deterministic checks only.
GEMINI_API_KEY=your-ai-studio-api-key
# GOOGLE_API_KEY=your-ai-studio-api-key

# Web UI: set to 1 to run only the deterministic checks (spends no quota)
# BONDY_NO_LLM=1

# --- Models (defaults shown) ---
# BONDY_MODEL=gemini-flash-latest
# Model for requests that carry images (the semantic image stage)
# BONDY_VISION_MODEL=gemini-flash-latest
# Used when the primary model fails (empty disables it). If the primary model
# answers 429 for your key, every batch spends an extra request before reaching
# the fallback: set BONDY_MODEL and BONDY_VISION_MODEL to the model that works.
# BONDY_FALLBACK_MODEL=gemini-3.5-flash-lite

# --- Web server only ---
# Protects POST /api/apply-fix. If unset, only requests from localhost are accepted.
# Unrelated to the Gemini key.
# BONDY_API_KEY=change-me

# --- Legacy ADK agent / Cloud deployment only (not used by the CLI or the scan pipeline) ---
# GOOGLE_GENAI_USE_VERTEXAI=True
# GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
# GOOGLE_CLOUD_LOCATION=global
